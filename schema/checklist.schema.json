{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:appsec-asvs-checklists:schema:checklist:1",
  "title": "ASVS verification checklist",
  "description": "Source format for a stack-specific verification checklist mapped to OWASP ASVS 5.0 and the OWASP API Security Top 10 (2023).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stack", "standards", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "prefix", "scope"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "pattern": "^[A-Z]{2,6}$" },
        "scope": { "type": "string", "minLength": 20 }
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asvs", "api_top10"],
      "properties": {
        "asvs": { "const": "5.0.0" },
        "api_top10": { "const": "2023" }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "title", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "code": { "type": "string", "pattern": "^[A-Z]{2,6}$" },
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "asvs", "level", "summary", "verification", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}-[A-Z]{2,6}-[0-9]{3}$",
          "description": "Stable item identifier: <stack prefix>-<section code>-<sequence>."
        },
        "title": { "type": "string", "minLength": 5, "maxLength": 90 },
        "asvs": {
          "type": "string",
          "pattern": "^V[1-9][0-9]?\\.[1-9][0-9]?\\.[1-9][0-9]?$",
          "description": "ASVS 5.0.0 requirement identifier, without the version prefix."
        },
        "related_asvs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^V[1-9][0-9]?\\.[1-9][0-9]?\\.[1-9][0-9]?$" }
        },
        "level": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "Minimum ASVS level of the primary requirement."
        },
        "api_top10": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^API(10|[1-9]):2023$" }
        },
        "summary": { "type": "string", "minLength": 20 },
        "verification": { "type": "string", "minLength": 40 },
        "evidence": { "type": "string", "minLength": 20 },
        "zap": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
